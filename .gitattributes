# Normalise line endings in the repository to LF.
#
# Without this, a Windows checkout commits CRLF and `cargo fmt --check` on the
# Linux CI runner disagrees with the same command on the developer's machine.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run at all.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary content.
*.png binary
*.jpg binary
*.ico binary
*.gif binary
